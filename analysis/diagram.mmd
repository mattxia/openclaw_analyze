classDiagram
 direction TB

 class AgentTool {
 <<interface>>
 +name: string
 +label: string
 +description: string
 +parameters: TSchema
 +execute() AgentToolResult
 }

 class ExecToolFactory {
 +createExecTool(defaults) AgentTool
 }

 AgentTool <|.. ExecToolFactory : 创建

 class ExecToolDefaults {
 +host: ExecHost
 +security: ExecSecurity
 +ask: ExecAsk
 +node: string
 +pathPrepend: string[]
 +safeBins: string[]
 +safeBinProfiles: Record
 +elevated: ExecElevatedDefaults
 +sandbox: BashSandboxConfig
 +cwd: string
 +sessionKey: string
 +agentId: string
 +timeoutSec: number
 +backgroundMs: number
 +allowBackground: boolean
 +notifyOnExit: boolean
 }

 class ExecToolDetails {
 +status: string
 +sessionId: string
 +pid: number
 +exitCode: number
 +durationMs: number
 +aggregated: string
 +approvalId: string
 +host: string
 +cwd: string
 }

 class ExecElevatedDefaults {
 +enabled: boolean
 +allowed: boolean
 +defaultLevel: string
 }

 class ExecSchema {
 +command: string
 +workdir: string
 +env: Record
 +yieldMs: number
 +background: boolean
 +timeout: number
 +pty: boolean
 +elevated: boolean
 +host: string
 +security: string
 +ask: string
 +node: string
 }

 ExecToolFactory --> ExecToolDefaults : 使用
 ExecToolFactory --> ExecToolDetails : 返回
 ExecToolFactory --> ExecSchema : 参数schema
 ExecToolDefaults --> ExecElevatedDefaults : 包含

 class ProcessSupervisor {
 <<interface>>
 +spawn(input) ManagedRun
 +cancel(runId, reason) void
 +cancelScope(scopeKey, reason) void
 +getRecord(runId) RunRecord
 +reconcileOrphans() void
 }

 class ManagedRun {
 +runId: string
 +pid: number
 +startedAtMs: number
 +stdin: ManagedRunStdin
 +wait() RunExit
 +cancel(reason) void
 }

 class SpawnInput {
 <<union>>
 +runId: string
 +sessionId: string
 +backendId: string
 +scopeKey: string
 +cwd: string
 +env: ProcessEnv
 +timeoutMs: number
 +captureOutput: boolean
 +onStdout(chunk) void
 +onStderr(chunk) void
 +mode: string
 }

 class SpawnChildInput {
 +mode: child
 +argv: string[]
 +stdinMode: string
 +windowsVerbatimArguments: boolean
 }

 class SpawnPtyInput {
 +mode: pty
 +ptyCommand: string
 }

 class RunExit {
 +reason: TerminationReason
 +exitCode: number
 +exitSignal: Signal
 +durationMs: number
 +stdout: string
 +stderr: string
 +timedOut: boolean
 }

 class RunRecord {
 +runId: string
 +sessionId: string
 +state: string
 +startedAtMs: number
 +exitCode: number
 }

 class RunRegistry {
 +add(record) void
 +updateState(runId, state, fields) void
 +touchOutput(runId) void
 +finalize(runId, fields) void
 +get(runId) RunRecord
 }

 ProcessSupervisor --> ManagedRun : spawn返回
 ProcessSupervisor --> SpawnInput : 输入
 SpawnInput <|-- SpawnChildInput
 SpawnInput <|-- SpawnPtyInput
 ProcessSupervisor --> RunRegistry : 使用
 RunRegistry --> RunRecord : 管理

 class ProcessSession {
 +id: string
 +command: string
 +scopeKey: string
 +sessionKey: string
 +pid: number
 +startedAt: number
 +cwd: string
 +exited: boolean
 +backgrounded: boolean
 +aggregated: string
 +tail: string
 +truncated: boolean
 +child: ChildProcess
 +stdin: SessionStdin
 +notifyOnExit: boolean
 }

 class ProcessRegistry {
 +addSession(session) void
 +getSession(id) ProcessSession
 +getFinishedSession(id) FinishedSession
 +deleteSession(id) void
 +appendOutput(session, stream, chunk) void
 +drainSession(session) string
 +markExited(session, code, signal, status) void
 +markBackgrounded(session) void
 +tail(aggregated, len) string
 }

 ProcessRegistry --> ProcessSession : 管理

 class ExecApprovalsFile {
 +defaults: object
 +agents: map
 }

 class ExecApprovalsEngine {
 +evaluateShellAllowlist(params) AllowlistEval
 +buildEnforcedShellCommand(params) EnforcedCmdResult
